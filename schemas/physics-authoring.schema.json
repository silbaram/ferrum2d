{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferrum2d.dev/schemas/physics-authoring.schema.json",
  "title": "Ferrum2D Physics Authoring Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "physics"
  ],
  "properties": {
    "physics": {
      "type": "object",
      "description": "Runtime Physics Spec. Export/compile keeps this object and strips physicsEditor metadata.",
      "properties": {
        "hd2d": {
          "$ref": "#/$defs/physicsHd2d"
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kinematicController": {
                "$ref": "#/$defs/physicsKinematicController"
              }
            },
            "allOf": [
              {
                "$ref": "#/$defs/physicsKinematicControllerBody"
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/physicsKinematicControllerMode"
        }
      ]
    },
    "physicsEditor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "lockedFields": {
          "$ref": "#/$defs/runtimeFieldPathList"
        },
        "agentEditableFields": {
          "$ref": "#/$defs/runtimeFieldPathList"
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bodyMetadata"
          }
        },
        "joints": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jointMetadata"
          }
        },
        "presets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/presetMetadata"
          }
        }
      }
    }
  },
  "$defs": {
    "runtimeFieldPathList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^physics\\.[A-Za-z0-9_.-]+$"
      }
    },
    "bodyMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "gizmo": {
          "enum": [
            "box",
            "circle",
            "capsule",
            "polygon",
            "edge",
            "chain"
          ]
        },
        "preset": {
          "type": "string"
        },
        "lockedFields": {
          "$ref": "#/$defs/runtimeFieldPathList"
        },
        "agentEditableFields": {
          "$ref": "#/$defs/runtimeFieldPathList"
        }
      }
    },
    "physicsHd2d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultHeight": {
          "type": "number",
          "minimum": 0
        },
        "maxStepHeight": {
          "type": "number",
          "minimum": 0
        },
        "maxDropHeight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "jointMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "gizmo": {
          "enum": [
            "anchor",
            "axis",
            "motor"
          ]
        },
        "lockedFields": {
          "$ref": "#/$defs/runtimeFieldPathList"
        },
        "agentEditableFields": {
          "$ref": "#/$defs/runtimeFieldPathList"
        }
      }
    },
    "presetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "target": {
          "enum": [
            "body",
            "collider",
            "joint",
            "material",
            "layer"
          ]
        }
      }
    },
    "physicsKinematicController": {
      "type": "object",
      "additionalProperties": false,
      "description": "native 물리 interval의 활성 solid convex kinematic body에 적용하는 자동 planar controller 옵션. 고정·가변 clock을 지원하며 생략하고 body를 재생성하면 기본값을 사용한다.",
      "properties": {
        "solidMaskBits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 4294967295
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 4
        },
        "maxStepHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 65536,
          "default": 0
        },
        "maxDropHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 65536,
          "default": 0
        },
        "allowLedgeDrop": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "physicsKinematicControllerMode": {
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "none" } }
      },
      "then": {
        "properties": {
          "bodies": {
            "additionalProperties": {
              "not": {
                "required": [
                  "kinematicController"
                ]
              }
            }
          }
        }
      }
    },
    "physicsKinematicControllerBody": {
      "if": {
        "required": [
          "kinematicController"
        ]
      },
      "then": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "kinematic"
          },
          "enabled": {
            "const": true
          },
          "collider": {
            "$ref": "#/$defs/physicsKinematicControllerSolidSource"
          },
          "colliders": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                },
                {
                  "required": [
                    "trigger"
                  ],
                  "properties": {
                    "trigger": {
                      "const": true
                    }
                  }
                },
                {
                  "$ref": "#/$defs/physicsKinematicControllerSolidSource"
                }
              ]
            },
            "not": {
              "items": {
                "not": {
                  "$ref": "#/$defs/physicsKinematicControllerSolidSource"
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "collider"
            ]
          },
          {
            "required": [
              "colliders"
            ]
          }
        ]
      }
    },
    "physicsKinematicControllerSolidSource": {
      "type": "object",
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "enum": [
            "aabb",
            "box",
            "circle",
            "capsule",
            "orientedBox",
            "convexPolygon"
          ]
        },
        "enabled": {
          "const": true
        },
        "trigger": {
          "const": false
        }
      }
    }
  }
}

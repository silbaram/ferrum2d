{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://ferrum2d.dev/schemas/topdown-authored-behavior-variant.schema.json",
  "title": "Ferrum2D Top-down Authored Behavior Variant",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "extendsGameSpec",
    "replayScenario",
    "semantics",
    "ids",
    "sceneComposition",
    "behaviorRecipes",
    "behaviorStateMachines",
    "expected"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "ferrum2d.topdown-shooter.authored-behavior-variant"
    },
    "version": {
      "const": 1
    },
    "extendsGameSpec": {
      "type": "string",
      "minLength": 1
    },
    "replayScenario": {
      "type": "string",
      "minLength": 1
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fsmStateEntryMode",
        "browserPlacement"
      ],
      "properties": {
        "fsmStateEntryMode": {
          "const": "manualReplaceSupported"
        },
        "browserPlacement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchorReplayBody",
            "target",
            "scale"
          ],
          "properties": {
            "anchorReplayBody": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "const": "worldCenter"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "actions",
        "timers"
      ],
      "properties": {
        "items": {
          "type": "object",
          "required": [
            "score"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "properties": {
            "score": {
              "const": 1
            }
          }
        },
        "actions": {
          "type": "object",
          "required": [
            "primary",
            "dash",
            "collect-score",
            "summon-enemy"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "properties": {
            "primary": {
              "const": 1
            },
            "dash": {
              "const": 2
            },
            "collect-score": {
              "const": 7
            },
            "summon-enemy": {
              "const": 11
            }
          }
        },
        "timers": {
          "type": "object",
          "required": [
            "wake"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "properties": {
            "wake": {
              "const": 13
            }
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/gameplayVariableDeclaration"
      }
    },
    "sceneComposition": {
      "type": "object",
      "required": [
        "prefabs",
        "fragments"
      ],
      "properties": {
        "initialFragment": {
          "type": "string",
          "minLength": 1
        },
        "prefabs": {
          "type": "object"
        },
        "fragments": {
          "type": "object"
        }
      }
    },
    "behaviorRecipes": {
      "type": "object",
      "required": [
        "entities"
      ],
      "properties": {
        "recipes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/behaviorRecipe"
          }
        },
        "entities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "recipes"
            ],
            "properties": {
              "recipes": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "$ref": "#/definitions/behaviorRecipeReference"
                    },
                    {
                      "$ref": "#/definitions/behaviorRecipe"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "behaviorStateMachines": {
      "type": "object",
      "required": [
        "machines"
      ],
      "properties": {
        "machines": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/behaviorStateMachine"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "replayHash",
        "finalScore",
        "eventFrame",
        "eventKinds",
        "actionFailureFrame",
        "actionFailureEventKinds",
        "timerFrame",
        "timerEventKinds",
        "states"
      ],
      "properties": {
        "replayHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "finalScore": {
          "type": "number"
        },
        "eventFrame": {
          "type": "number"
        },
        "eventKinds": {
          "type": "array",
          "items": {
            "enum": [
              "collisionDamage",
              "factionDamageDenied",
              "pickupCollected",
              "collisionDespawn",
              "behaviorStateChanged",
              "interaction"
            ]
          },
          "minItems": 1
        },
        "timerFrame": {
          "type": "number"
        },
        "actionFailureFrame": {
          "type": "number"
        },
        "actionFailureEventKinds": {
          "type": "array",
          "items": {
            "enum": [
              "actionFailed"
            ]
          },
          "minItems": 1
        },
        "timerEventKinds": {
          "type": "array",
          "items": {
            "enum": [
              "timer",
              "prefabSpawned",
              "behaviorStateChanged"
            ]
          },
          "minItems": 1
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "agentAttachment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/agentAttachmentEntry"
          }
        }
      }
    }
  },
  "definitions": {
    "agentAttachmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "role",
        "behaviorProfiles",
        "commandCount",
        "commandTypes"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "worldObject",
            "actor"
          ]
        },
        "behaviorProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commandCount": {
          "type": "integer",
          "minimum": 0
        },
        "commandTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "behaviorRecipeReference": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "$ref": "#/definitions/behaviorRecipeOverride"
        }
      },
      "not": {
        "required": [
          "kind"
        ]
      }
    },
    "behaviorRecipe": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "health",
            "damage",
            "faction",
            "lifetime",
            "scoreReward",
            "pickup",
            "collisionPickup",
            "collisionAreaDamage",
            "collisionKnockback",
            "collisionEmitEffect",
            "collisionSpawnPrefab",
            "collisionSound",
            "collisionParticle",
            "collisionShake",
            "collisionDespawn",
            "chase",
            "seekTarget",
            "accelerate",
            "interaction",
            "projectileAction",
            "dashAction",
            "meleeAction",
            "spawnPrefabAction",
            "timerTrigger",
            "setVariable",
            "incrementVariable"
          ]
        },
        "guard": {
          "$ref": "#/definitions/gameplayVariableComparison"
        },
        "when": {
          "$ref": "#/definitions/gameplayEventPredicate"
        },
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "variableId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "value": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "amount": {
          "type": "number"
        },
        "faction": {
          "$ref": "#/definitions/behaviorRecipeFaction"
        },
        "damages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/behaviorRecipeFaction"
          }
        },
        "tileImpact": {
          "enum": [
            "despawn",
            "passThrough",
            "bounce"
          ]
        },
        "trigger": {
          "enum": [
            "contact",
            "enter"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "faction"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "faction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "setVariable",
                  "incrementVariable"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "when"
            ],
            "anyOf": [
              {
                "required": [
                  "variable"
                ]
              },
              {
                "required": [
                  "variableId"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "setVariable"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "required": [
              "guard"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "damage",
                  "collisionPickup",
                  "collisionAreaDamage",
                  "collisionKnockback",
                  "collisionEmitEffect",
                  "collisionSpawnPrefab",
                  "collisionSound",
                  "collisionParticle",
                  "collisionShake",
                  "collisionDespawn",
                  "interaction",
                  "timerTrigger"
                ]
              }
            }
          }
        }
      ]
    },
    "behaviorRecipeOverride": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "faction": {
          "$ref": "#/definitions/behaviorRecipeFaction"
        },
        "damages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/behaviorRecipeFaction"
          }
        },
        "tileImpact": {
          "enum": [
            "despawn",
            "passThrough",
            "bounce"
          ]
        },
        "trigger": {
          "enum": [
            "contact",
            "enter"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "behaviorRecipeFaction": {
      "anyOf": [
        {
          "enum": [
            "neutral",
            "player",
            "enemy"
          ]
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      ]
    },
    "gameplayVariableDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "type",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "global",
            "scene"
          ]
        },
        "type": {
          "enum": [
            "integer",
            "real",
            "bool"
          ]
        },
        "default": {
          "type": [
            "number",
            "boolean"
          ]
        }
      }
    },
    "gameplayVariableComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "type": {
          "const": "variableComparison"
        },
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "variableId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "op": {
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "otherVariable": {
          "type": "string",
          "minLength": 1
        },
        "otherVariableId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "variable"
              ]
            },
            {
              "required": [
                "variableId"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "value"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "otherVariable"
                    ]
                  },
                  {
                    "required": [
                      "otherVariableId"
                    ]
                  }
                ]
              }
            },
            {
              "anyOf": [
                {
                  "required": [
                    "otherVariable"
                  ]
                },
                {
                  "required": [
                    "otherVariableId"
                  ]
                }
              ],
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          ]
        }
      ]
    },
    "gameplayEventPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event"
      ],
      "properties": {
        "type": {
          "const": "gameplayEvent"
        },
        "event": {
          "enum": [
            "interaction",
            "collisionDamage",
            "collisionDespawn",
            "timer",
            "pickupCollected",
            "tileImpact"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "timer": {
          "type": "string",
          "minLength": 1
        },
        "timerId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "item": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "tileImpact": {
          "enum": [
            "despawn",
            "bounce"
          ]
        },
        "tileImpactCode": {
          "enum": [
            0,
            2
          ]
        }
      }
    },
    "behaviorStateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "states"
      ],
      "properties": {
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/behaviorStateMachineState"
          }
        }
      }
    },
    "behaviorStateMachineState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "behaviorRecipes": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/behaviorStateMachineTransition"
          }
        }
      }
    },
    "behaviorStateMachineTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "oneOf": [
            {
              "$ref": "#/definitions/gameplayEventPredicate"
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/gameplayVariableComparison"
                },
                {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "variableComparison"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}

{
  "name": "@ferrum2d/ferrum-web",
  "version": "0.1.0",
  "private": true,
  "description": "Ferrum2D browser runtime and WebGL2 platform layer",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./starter-scenes": {
      "types": "./dist/starter-scenes.d.ts",
      "import": "./dist/starter-scenes.js"
    },
    "./labs": {
      "types": "./dist/labs.d.ts",
      "import": "./dist/labs.js"
    },
    "./quality": {
      "types": "./dist/quality.d.ts",
      "import": "./dist/quality.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "README.md",
    "dist",
    "pkg/ferrum_core.js",
    "pkg/ferrum_core.d.ts",
    "pkg/ferrum_core_factory.js",
    "pkg/ferrum_core_factory.d.ts",
    "pkg/ferrum_core_bg.wasm",
    "pkg/ferrum_core_bg.wasm.d.ts",
    "pkg/package.json"
  ],
  "scripts": {
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:dist-test": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\"",
    "build": "node ../../scripts/build/generate-wasm-bindings-factory.mjs && node ../../scripts/build/generate-native-file-sdk-build.mjs && pnpm run clean:dist && tsc -p tsconfig.json && node ../../scripts/build/fix-dist-esm-extensions.mjs dist && node ../../scripts/build/copy-basis-transcoder.mjs",
    "check:package": "node ../../scripts/package/check-package-files.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run test:native-file-sdk-build && pnpm run test:wasm-bindings-factory && pnpm run build && pnpm run clean:dist-test && tsc -p tsconfig.test.json && node ../../scripts/build/fix-dist-esm-extensions.mjs dist-test && node -e \"require('node:fs').cpSync('pkg', 'dist-test/pkg', { recursive: true })\" && node --test dist-test/test/*.test.js",
    "test:wasm-bindings-factory": "node --test ../../scripts/build/generate-wasm-bindings-factory.test.mjs",
    "test:native-file-sdk-build": "node --test ../../scripts/build/generate-native-file-sdk-build.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrum2D Studio",
  "version": "0.1.0",
  "identifier": "com.ferrum2d.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @ferrum2d/studio dev:desktop-host",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @ferrum2d/studio build",
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ferrum2D Studio",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "connect-src": "'self' data: ipc: http://ipc.localhost ferrum-asset: http://ferrum-asset.localhost https://ferrum-asset.localhost https://api.github.com",
        "img-src": "'self' data: blob: ferrum-asset: http://ferrum-asset.localhost https://ferrum-asset.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "createUpdaterArtifacts": false
  }
}
